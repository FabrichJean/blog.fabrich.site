PORT=3000
# URL publique (utilisée pour RSS / sitemap / liens canoniques)
SITE_URL=http://localhost:3000
# Mettre "production" derrière HTTPS (cookies Secure, HSTS)
NODE_ENV=development
# Derrière un reverse proxy (nginx, Caddy…) : true
# TRUST_PROXY=true
# Emplacement des données (SQLite) et des images
# DATA_DIR=./data
# UPLOAD_DIR=./uploads

# E-mails (code OTP d'inscription, newsletter). Sans SMTP_URL : le code OTP s'affiche dans la console du serveur
# (développement) ou l'inscription est refusée (production) ; la newsletter est inscrite sans confirmation et l'envoi est désactivé.
# SMTP_URL=smtp://utilisateur:motdepasse@smtp.exemple.fr:587
# MAIL_FROM="Mon blog <blog@exemple.fr>"

# Import automatique des flux RSS (minutes ; 0 pour désactiver)
# FEED_REFRESH_MINUTES=60

# Envoi du code OTP d'inscription via un service d'e-mails à modèles (API emaildo).
# Prioritaire sur SMTP pour l'OTP ; la newsletter continue d'utiliser SMTP_URL.
# EMAILDO_URL=https://emaildo.fabrich.site/api/v1/send
# EMAILDO_API_KEY=eg_xxxxxxxxxxxxxxxxxxxxxxxx
# EMAILDO_SERVICE_ID=mon-service-a1b2c3d4
# EMAILDO_OTP_TEMPLATE_ID=cmxxxxxxxxxxxxxxxxxxxxxxx
