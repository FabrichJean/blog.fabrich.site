PORT=3000
# URL publique (utilisée pour RSS / sitemap / liens canoniques)
SITE_URL=http://localhost:3000
# Mettre "production" derrière HTTPS (cookies Secure, HSTS)
NODE_ENV=development
# Derrière un reverse proxy (nginx, Caddy…) : true
# TRUST_PROXY=true
# Emplacement des données (SQLite) et des images
# DATA_DIR=./data
# UPLOAD_DIR=./uploads

# Newsletter : sans SMTP_URL, les inscriptions sont actives sans confirmation e-mail et l'envoi est désactivé.
# SMTP_URL=smtp://utilisateur:motdepasse@smtp.exemple.fr:587
# MAIL_FROM="Mon blog <blog@exemple.fr>"

# Import automatique des flux RSS (minutes ; 0 pour désactiver)
# FEED_REFRESH_MINUTES=60
