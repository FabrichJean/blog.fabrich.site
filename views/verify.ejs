<%- include('partials/head', { norail: true }) %>
<div class="auth">
  <div class="auth-art">
    <h2><%= site.site_title %></h2>
    <ul><li><%= t('auth_bullet1') %></li><li><%= t('auth_bullet2') %></li><li><%= t('auth_bullet3') %></li></ul>
  </div>
  <div class="auth-form">
    <h1><%= t('otp_title') %></h1>
    <p class="muted"><%= t('otp_intro', { email }) %> <span class="small"><%= t('otp_expires', { min: ttlMin }) %></span></p>
    <% if (devMode) { %><p class="notice small"><%= t('otp_dev') %></p><% } %>
    <% if (info) { %><p class="notice ok" role="status"><%= info %></p><% } %>
    <% if (error) { %><p class="notice err" role="alert"><%= error %></p><% } %>
    <form method="post" action="<%= prefix %>/signup/verify" class="form" data-otp-form>
      <label><%= t('otp_label') %>
        <input class="otp-input" name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9 ]{6,7}" maxlength="7" required autofocus placeholder="000000" data-otp>
      </label>
      <div><button class="btn" type="submit"><%= t('otp_verify') %></button></div>
    </form>
    <form method="post" action="<%= prefix %>/signup/resend" class="otp-resend">
      <button class="link" type="submit"><%= t('otp_resend') %></button>
      <span class="muted">·</span>
      <a href="<%= prefix %>/signup"><%= t('otp_change') %></a>
    </form>
  </div>
</div>
<%- include('partials/foot', { norail: true }) %>
