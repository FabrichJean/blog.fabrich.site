<%- include('partials/head', { norail: true }) %>
<div class="auth">
  <div class="auth-art">
    <h2><%= site.site_title %></h2>
    <ul><li><%= t('auth_bullet1') %></li><li><%= t('auth_bullet2') %></li><li><%= t('auth_bullet3') %></li><li><%= t('auth_bullet4') %></li></ul>
  </div>
  <div class="auth-form">
    <h1><%= t('signup') %></h1>
    <% if (error) { %><p class="notice err" role="alert"><%= error %></p><% } %>
    <form method="post" action="<%= prefix %>/signup" class="form">
      <input type="hidden" name="next" value="<%= next %>">
      <div class="hp" aria-hidden="true"><label>Site web <input name="website" tabindex="-1" autocomplete="off"></label></div>
      <label><%= t('display_name') %> <input name="display_name" required maxlength="60" autocomplete="name" value="<%= v.display_name || '' %>"></label>
      <label><%= t('email') %> <input type="email" name="email" required autocomplete="email" value="<%= v.email || '' %>"></label>
      <label><%= t('password') %> <small class="muted">(<%= t('password_hint') %>)</small> <input type="password" name="password" required minlength="8" autocomplete="new-password"></label>
      <div><button class="btn" type="submit"><%= t('signup') %></button></div>
    </form>
    <p class="small"><%= t('have_account') %> <a href="<%= prefix %>/login<%= next ? '?next=' + encodeURIComponent(next) : '' %>"><strong><%= t('login') %></strong></a></p>
  </div>
</div>
<%- include('partials/foot', { norail: true }) %>
