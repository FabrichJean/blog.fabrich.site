<!doctype html>
<html lang="fr" data-theme="light">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<% if (typeof csrf !== 'undefined' && csrf) { %><meta name="csrf-token" content="<%= csrf %>"><% } %>
<title><%= title %> — Rédaction</title>
<link rel="preload" href="/static/fonts/fraunces-latin-full-normal.woff2" as="font" type="font/woff2" crossorigin>
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cpath d='M16 3a13 13 0 1 1-13 13V3z' fill='%23ff4b2b' stroke='%2316140f' stroke-width='2.500'/%3E%3C/svg%3E">
<script src="/static/js/theme-init.js"></script>
<link rel="stylesheet" href="/static/css/style.css?v=<%= assetV %>">
<link rel="stylesheet" href="/theme.css?v=<%= siteAll.theme_accent.slice(1) %><%= siteAll.theme_accent_dark.slice(1) %><%= siteAll.theme_font %>">
<link rel="stylesheet" href="/static/css/admin.css">
<script src="/static/js/app.js?v=<%= assetV %>" defer></script>
<% if (user) { %><script src="/static/js/notify.js" defer></script><% } %>
</head>
<body class="admin">
<% const on = (...p) => p.includes(path) ? 'on' : ''; const c = locals.counts || {}; %>
<% if (user) { %>
<div class="admin-shell">
<aside class="admin-side">
  <a class="wordmark small" href="/admin"><%= site.site_title %></a>
  <p class="kicker">Rédaction</p>
  <nav class="side-nav" aria-label="Administration">
    <a href="/admin" class="<%= on('/') %>"><%- icon('sparkle', 16) %> Tableau de bord</a>
    <a href="/admin/posts/new" class="accent"><%- icon('plus', 16) %> Écrire un article</a>
    <a href="/admin/posts" class="<%= on('/posts') %>"><%- icon('history', 16) %> Articles</a>
    <% if (user.role === 'admin') { %>
    <p class="group">Contenu</p>
    <a href="/admin/categories" class="<%= on('/categories') %>"><%- icon('tag', 16) %> Catégories</a>
    <a href="/admin/sources" class="<%= on('/sources') %>"><%- icon('rss', 16) %> Sources RSS</a>
    <a href="/admin/submissions" class="<%= on('/submissions') %>"><%- icon('link', 16) %> Liens proposés <% if (c.submissions) { %><b class="pill"><%= c.submissions %></b><% } %></a>
    <p class="group">Communauté</p>
    <a href="/admin/comments" class="<%= on('/comments') %>"><%- icon('comment', 16) %> Commentaires <% if (c.comments) { %><b class="pill"><%= c.comments %></b><% } %></a>
    <a href="/admin/newsletter" class="<%= on('/newsletter') %>"><%- icon('mail', 16) %> Newsletter</a>
    <a href="/admin/users" class="<%= on('/users') %>"><%- icon('user', 16) %> Utilisateurs</a>
    <p class="group">Système</p>
    <a href="/admin/backup" class="<%= on('/backup') %>"><%- icon('copy', 16) %> Export / import</a>
    <a href="/admin/settings" class="<%= on('/settings') %>"><%- icon('globe', 16) %> Réglages</a>
    <% } %>
  </nav>
  <div class="side-foot">
    <a href="/" target="_blank" rel="noopener"><%- icon('link', 14) %> Voir le site</a>
    <div class="me-row">
      <a class="who" href="/admin/profile"><span class="avatar sm <%= avatarClass(user.display_name) %>"><%= user.display_name.slice(0, 1).toUpperCase() %></span><span><%= user.display_name %></span></a>
      <a class="icon-btn notif-link" href="/notifications" data-notif aria-label="Notifications" title="Notifications"><%- icon('bell', 14) %><span class="badge-n" data-notif-count <%= notifCount ? '' : 'hidden' %>><%= notifCount > 9 ? '9+' : notifCount %></span></a>
      <button type="button" class="icon-btn" data-theme-toggle aria-label="Changer de thème"><span class="when-dark"><%- icon('sun', 14) %></span><span class="when-light"><%- icon('moon', 14) %></span></button>
      <form method="post" action="/admin/logout"><input type="hidden" name="_csrf" value="<%= csrf %>"><button class="icon-btn" aria-label="Déconnexion" title="Déconnexion"><%- icon('out', 14) %></button></form>
    </div>
  </div>
</aside>
<% } %>
<main class="admin-main <%= user ? '' : 'bare' %>">
<% if (typeof flash !== 'undefined' && flash) { %><p class="notice ok" role="status"><%= flash.msg %></p><% } %>
